# Copy this file to .env and fill in the values. Never commit .env.

# --- Database (Neon Postgres) -------------------------------------------
# Easiest: run `npx neon init` in this folder; it creates or links a Neon
# project and writes these values for you. Or copy them by hand from the
# Neon dashboard → your project → Connect.
# DATABASE_URL: the POOLED connection string (host contains "-pooler").
# DATABASE_URL_UNPOOLED: the DIRECT connection string (same, without "-pooler").
#               Used only by Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Public URL of the app. Needed in production; optional on localhost.
AUTH_URL="http://localhost:3000"

# Google login (optional). Leave empty to hide the Google button.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Site ---------------------------------------------------------------
# Public address for link previews, robots.txt and sitemap.xml (optional).
# Defaults to https://gymna-two.vercel.app.
SITE_URL=""

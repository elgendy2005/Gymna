// Gymna database schema.
// Covers authentication, the training profile, the exercise library, plans
// and workout logs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  /// bcrypt hash. Null for accounts that only sign in with Google.
  passwordHash  String?
  locale        String     @default("ar")
  unitSystem    UnitSystem @default(METRIC)
  /// IANA time zone from the browser. Decides which calendar day is "today".
  timezone      String     @default("Africa/Cairo")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts        Account[]
  profile         Profile?
  healthScreening HealthScreening?
  sessions        Session[]
  baselines       StrengthBaseline[]
  plans           Plan[]
  workouts        WorkoutSession[]
  setLogs         SetLog[]
  exerciseStats   ExerciseStat[]
}

/// OAuth accounts linked to a user (Auth.js adapter model).
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

/// Unused while sessions are JWTs, kept so the Auth.js adapter is complete.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// --- Phase 2: profile and health screening --------------------------------

enum Gender {
  MALE
  FEMALE
}

enum Goal {
  FAT_LOSS
  MUSCLE_GAIN
  STRENGTH
  GENERAL_FITNESS
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Equipment {
  FULL_GYM
  DUMBBELLS
  BODYWEIGHT
}

/// How long the user has trained with weights.
enum TrainingExperience {
  NEVER
  UNDER_6_MONTHS
  OVER_6_MONTHS
  OVER_2_YEARS
}

/// Training profile from onboarding. Body measurements are always metric.
model Profile {
  userId         String    @id
  /// Stored instead of age so it stays correct as years pass.
  birthYear      Int
  gender         Gender
  heightCm       Float
  weightKg       Float
  goal           Goal
  level          Level
  daysPerWeek    Int
  sessionMinutes Int
  equipment      Equipment
  /// Null for accounts created before the question existed.
  experience     TrainingExperience?
  /// Body areas that get extra volume. See FOCUS_AREAS.
  focusAreas     String[]
  /// Weekdays to train on: 0 is Saturday, 6 is Friday. Empty means "use the
  /// default spread for daysPerWeek".
  trainingDays   Int[]
  /// Smallest jumps the user's gym offers, used to round suggested weights.
  dumbbellStepKg Float     @default(2)
  machineStepKg  Float     @default(5)
  onboardedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A lift the user already knew their weight for at onboarding. Gives the
/// weight engine a starting point before there is any logged history.
model StrengthBaseline {
  userId    String
  /// One of BASELINE_LIFTS, e.g. "bench_press".
  lift      String
  weightKg  Float
  reps      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, lift])
}

/// PAR-Q style answers. Sensitive: only ever read for its owner.
model HealthScreening {
  userId            String   @id
  heartCondition    Boolean  @default(false)
  chestPain         Boolean  @default(false)
  highBloodPressure Boolean  @default(false)
  dizziness         Boolean  @default(false)
  diabetes          Boolean  @default(false)
  lowerBack         Boolean  @default(false)
  knee              Boolean  @default(false)
  shoulder          Boolean  @default(false)
  otherJoint        Boolean  @default(false)
  recentSurgery     Boolean  @default(false)
  pregnancy         Boolean  @default(false)
  notes             String?
  /// Derived: true when any answer is yes. Makes the plan conservative.
  needsClearance    Boolean  @default(false)
  /// Derived exercise tags to avoid, e.g. "knee", "lower_back".
  contraindications String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Phase 3: exercise library --------------------------------------------

enum ExerciseEquipment {
  BODYWEIGHT
  DUMBBELL
  BARBELL
  EZ_BAR
  KETTLEBELL
  CABLE
  MACHINE
  BANDS
  MEDICINE_BALL
  EXERCISE_BALL
  FOAM_ROLL
  OTHER
}

enum ExerciseCategory {
  STRENGTH
  STRETCHING
  PLYOMETRICS
  CARDIO
  POWERLIFTING
  OLYMPIC_WEIGHTLIFTING
  STRONGMAN
}

enum MediaKind {
  FRAME_SEQUENCE
  GIF
  VIDEO
  LOTTIE
}

/// One exercise. Imported from free-exercise-db; the curated core set also
/// carries Arabic text, safety tags and a movement pattern.
model Exercise {
  id                String            @id @default(cuid())
  /// URL-safe identifier, also the media folder name.
  slug              String            @unique
  nameEn            String
  nameAr            String?
  category          ExerciseCategory
  equipment         ExerciseEquipment
  difficulty        Level
  primaryMuscles    String[]
  secondaryMuscles  String[]
  isCompound        Boolean           @default(false)
  /// Set for curated exercises only. See MOVEMENT_PATTERNS.
  movementPattern   String?
  /// Health tags this exercise should be avoided with, e.g. "knee".
  contraindications String[]
  /// Extra kit needed, e.g. "bench", "pullup_bar".
  requirements      String[]
  /// True when the program engine may put this exercise in a plan.
  engineEligible    Boolean           @default(false)
  instructionsEn    String[]
  instructionsAr    String[]
  mistakesEn        String[]
  mistakesAr        String[]
  breathingEn       String?
  breathingAr       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  media         ExerciseMedia[]
  planExercises    PlanExercise[]
  sessionExercises SessionExercise[]
  setLogs          SetLog[]
  stats            ExerciseStat[]

  @@index([equipment])
  @@index([difficulty])
  @@index([movementPattern])
  @@index([engineEligible])
}

/// A demo for an exercise. The UI plays the row with the highest priority,
/// so better media (GIF, video, Lottie) can be added without code changes.
model ExerciseMedia {
  id         String    @id @default(cuid())
  exerciseId String
  kind       MediaKind
  /// Where the media came from, e.g. "free-exercise-db".
  provider   String
  /// Paths under the media base URL, or absolute URLs.
  urls       String[]
  priority   Int       @default(0)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, provider])
}

// --- Phase 4: weekly plan --------------------------------------------------

enum DayType {
  FULL_BODY
  UPPER
  LOWER
  PUSH
  PULL
  LEGS
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

/// A weekly plan built by the program engine. A user has one ACTIVE plan;
/// older ones are archived, not deleted, so logged sessions keep their link.
model Plan {
  id            String     @id @default(cuid())
  userId        String
  status        PlanStatus @default(ACTIVE)
  /// One of SPLITS, e.g. "upper_lower".
  split         String
  /// The engine rules the plan was built with. See ENGINE_VERSION.
  engineVersion Int
  /// Snapshot of the answers the plan was built from, plus the seed.
  inputs        Json
  createdAt     DateTime   @default(now())
  archivedAt    DateTime?

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  days PlanDay[]

  @@index([userId, status])
}

model PlanDay {
  id               String  @id @default(cuid())
  planId           String
  order            Int
  /// 0 is Saturday, 6 is Friday.
  weekday          Int
  type             DayType
  estimatedMinutes Int

  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercises PlanExercise[]
  sessions  WorkoutSession[]

  @@unique([planId, order])
}

model PlanExercise {
  id          String  @id @default(cuid())
  planDayId   String
  order       Int
  exerciseId  String
  sets        Int
  /// Reps, or seconds for timed holds. See isTimedExercise.
  repMin      Int
  repMax      Int
  restSeconds Int
  /// True when a focus area added this exercise or added a set to it.
  focusExtra  Boolean @default(false)

  day      PlanDay  @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@unique([planDayId, order])
  @@index([exerciseId])
}

// --- Phase 5: workout sessions and logs -------------------------------------

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ExerciseStatus {
  PENDING
  DONE
  SKIPPED
}

enum SetKind {
  WARMUP
  WORKING
}

/// The lifter's answer to "how did that feel?".
enum EffortFeedback {
  EASY
  RIGHT
  HARD
}

/// One workout. It copies its exercises and targets from the plan when it
/// starts, so later plan changes, swaps and skips never rewrite history.
model WorkoutSession {
  id              String        @id @default(cuid())
  userId          String
  /// The plan day this session came from. Null once that plan is deleted.
  planDayId       String?
  dayType         DayType
  /// The calendar day in the user's own time zone.
  date            DateTime      @db.Date
  status          SessionStatus @default(IN_PROGRESS)
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  durationSeconds Int?
  /// Sum of weight x reps over the working sets, in kg.
  totalVolumeKg   Float?
  /// Which cooldown message the finish screen showed, so a reload shows it again.
  cooldownKey     String?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDay   PlanDay?          @relation(fields: [planDayId], references: [id], onDelete: SetNull)
  exercises SessionExercise[]

  @@index([userId, date])
  @@index([userId, status])
}

model SessionExercise {
  id                String          @id @default(cuid())
  sessionId         String
  order             Int
  exerciseId        String
  /// Set when the user swapped the planned exercise for this one.
  swappedFromId     String?
  status            ExerciseStatus  @default(PENDING)
  targetSets        Int
  /// Reps, or seconds for timed holds.
  repMin            Int
  repMax            Int
  restSeconds       Int
  /// What the weight engine suggested, in kg. Null for bodyweight exercises.
  suggestedWeightKg Float?
  /// One of REASON_CODES in the weight engine.
  reasonCode        String
  /// The numbers behind the reason and which wording was shown.
  reasonData        Json?
  /// True the first time the user does this exercise.
  calibration       Boolean         @default(false)
  feedback          EffortFeedback?
  notes             String?

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
  sets     SetLog[]

  @@index([sessionId, order])
  @@index([exerciseId])
}

/// One set. Rows are created with the session and filled in as sets are done.
model SetLog {
  id                String    @id @default(cuid())
  sessionExerciseId String
  /// Copied from the session so history queries need no joins.
  userId            String
  exerciseId        String
  order             Int
  kind              SetKind
  targetReps        Int
  /// Per dumbbell for dumbbell exercises. Null for bodyweight exercises.
  weightKg          Float?
  reps              Int?
  /// Null until the set is checked off.
  completedAt       DateTime?
  /// Estimated one-rep max from this set.
  e1rmKg            Float?
  isPr              Boolean   @default(false)

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise        Exercise        @relation(fields: [exerciseId], references: [id])

  @@index([sessionExerciseId, order])
  @@index([userId, exerciseId, completedAt])
}

/// Records and current strength per user and exercise. A cache over SetLog:
/// suggestions are always computed from the logged sets themselves.
model ExerciseStat {
  userId             String
  exerciseId         String
  /// Best estimate of the recent window: what suggestions build on.
  e1rmKg             Float?
  bestE1rmKg         Float?
  bestE1rmAt         DateTime?
  maxWeightKg        Float?
  maxSessionVolumeKg Float?
  /// Completed sessions that included this exercise.
  sessions           Int       @default(0)
  updatedAt          DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  @@id([userId, exerciseId])
}
